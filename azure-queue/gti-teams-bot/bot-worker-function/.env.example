# =============================================================================
# GTI Teams Bot (Agentic) — Worker Function — Environment Configuration
# =============================================================================
# For local development with `func start`, put these values into the
# "Values" object in local.settings.json instead — Azure Functions Core
# Tools does not read a .env file. This file documents the same settings
# for reference, and is used if you run a script directly with `python`.
#
# REQUIRED settings have no usable default — this function will fail (either
# at cold start or on the first message) if left unset.
# =============================================================================

# ── Microsoft Teams / Bot Framework (Azure Bot registration) — REQUIRED ───────
# Must be the SAME User-Assigned Managed Identity client id used by
# bot-ingest-function/.env — both apps authenticate as one bot. Also used to
# recognize the bot's own placeholder messages in channel thread history
# (app/teams/thread.py, is_placeholder_message).
CLIENT_ID=your-managed-identity-client-id-here
MANAGED_IDENTITY_CLIENT_ID=your-managed-identity-client-id-here

# ── Google Threat Intelligence (GTI) Agentic API — REQUIRED ───────────────────
# Authenticates requests via the x-apikey header to /agentspace/sessions.
GTI_API_KEY=your-gti-api-key-here

# Client-side read timeout (seconds) for a single GTI Agentic API call. Fixed
# — no longer a Bicep deployment parameter — edit this value directly to
# change it. Keep this, host.json's functionTimeout, and
# extensions.queues.visibilityTimeout harmonized — see app/config.py's
# comment on gti_timeout_seconds. Default (480s = 8 min) fits safely under a
# Consumption plan's hard 10-minute functionTimeout ceiling. Raise this (and
# host.json's functionTimeout, via the AzureFunctionsJobHost__functionTimeout
# app setting) together if this Function App is deployed on Flex Consumption
# instead (30-minute ceiling).
GTI_TIMEOUT_SECONDS=480

# ── Storage (Blob + Table) — REQUIRED for output-format & session persistence ─
# Backs app/output_format_store.py (response formatting override) and
# app/gti/session_store.py (per-thread GTI session continuity). Azure
# Functions provides this automatically in `func start` and when deployed —
# only set it manually if running a script outside the Functions host.
# Must point at the SAME storage account bot-ingest-function/ uses.
# AzureWebJobsStorage=

# ── Queue trigger — job hand-off from the Ingest Function App ────────────────
# Name of the Storage Queue this function is triggered from. Must match
# bot-ingest-function/.env's JOB_QUEUE_NAME exactly. The Functions runtime
# automatically creates and routes exhausted retries to "<this>-poison".
JOB_QUEUE_NAME=gti-query-jobs

# A dequeued job older than this (seconds) is treated as stale — the
# placeholder is updated to say so instead of running an expensive GTI
# query for a request that old. Fixed — no longer a Bicep deployment
# parameter — edit this value directly to change it. See app/config.py's
# comment for why this must stay under gti_timeout_seconds + functionTimeout.
MAX_JOB_AGE_SECONDS=480

# ── Output format instructions (optional) ──────────────────────────────────────
# Optional formatting instructions applied to every response (e.g. "Show
# severity as bold text instead of emoji"). Seeds the JSON config blob in
# this app's storage account on first read (app/output_format_store.py) —
# after that, the blob is the source of truth and this value is ignored.
OUTPUT_FORMAT_INSTRUCTIONS=

# ── Microsoft Graph — channel thread context (optional) ──────────────────────
# Requires the Managed Identity above to be granted the Graph APPLICATION
# permission ChannelMessage.Read.All with tenant-admin consent. Channel-only —
# Teams has no thread concept for personal/group chats. A second message in
# the same channel thread also reuses its GTI session (see
# app/gti/session_store.py above) instead of starting a fresh one.
THREAD_CONTEXT_ENABLED=true
THREAD_CONTEXT_MESSAGE_COUNT=5

# Logging is hardcoded (plain text, INFO level) in app/logging_config.py —
# not configurable via environment. Azure Functions forwards it to
# Application Insights automatically.
