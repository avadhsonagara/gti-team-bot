# =============================================================================
# GTI Teams Bot (Agentic) — Azure Container Apps Environment Configuration
# =============================================================================
# Read directly from a .env file in this directory (via pydantic-settings) —
# for local development, copy this to .env and fill in the values. In
# Container Apps, set these as the Container App's environment variables /
# secrets instead; .env is not deployed (see .dockerignore).
#
# REQUIRED settings have no usable default — the bot will fail (either at
# startup or on the first message) if they're left unset. Everything else
# has a working default and only needs to be set to override it.
# =============================================================================

# ── Microsoft Teams / Bot Framework (Azure Bot registration) — REQUIRED ───────
# Verifies inbound Teams activities (app/teams/auth.py) and authenticates
# outbound calls to the Bot Framework Connector API and Microsoft Graph
# (app/teams/bot_client.py, app/graph/client.py). Both settings should be the
# same User-Assigned Managed Identity's client ID — attach that identity to
# the Container App resource. There is no client-secret path in this codebase.
CLIENT_ID=your-managed-identity-client-id-here
MANAGED_IDENTITY_CLIENT_ID=your-managed-identity-client-id-here

# ── Google Threat Intelligence (GTI) Agentic API — REQUIRED ───────────────────
# Authenticates requests via the x-apikey header to /agentspace/sessions.
GTI_API_KEY=your-gti-api-key-here

# Read timeout (seconds) for a single GTI Agentic API call (app/gti/client.py).
# Set this above your slowest real query's worst-case duration — a container
# has no platform-imposed HTTP ceiling like Azure Functions' 230s, so this is
# the only thing that can cut a slow-but-working call short. A read timeout
# (GTI accepted the request but took longer than this to respond) is NOT
# retried — see app/gti/client.py — since GTI may already be mid-processing
# and a retry could create a duplicate session or replay the message; the
# query just fails fast with a "took too long" reply after this one wait.
# Only connect/write/pool timeouts and 5xx/429 responses are retried, and
# those individually resolve fast, so the practical worst case stays close
# to this value — comfortably inside Premium ingress's 30-minute maximum
# idle timeout (see README.md).
GTI_TIMEOUT_SECONDS=600

# There is deliberately no MAX_CONCURRENT_REQUESTS knob here — concurrency is
# controlled at the platform level via the Container Apps environment's HTTP
# scale rule (concurrentRequests / --scale-rule-http-concurrency) instead of
# in-process, the same way GCP Cloud Run's --concurrency is set outside the
# container. See README.md for how that setting's semantics differ from
# Cloud Run's before relying on it as a hard cap.

# ── Storage (Blob + Table) — REQUIRED for output-format & session persistence ─
# Backs app/output_format_store.py (response formatting override) and
# app/gti/session_store.py (per-thread GTI session continuity). Without this,
# the bot still answers messages, but silently never persists either — every
# message starts a fresh GTI session and output-format instructions are lost
# on restart. Startup logs report this as "storage=MISSING" when unset.
STORAGE_CONNECTION_STRING=

# ── Output format instructions (optional) ──────────────────────────────────────
# Optional formatting instructions applied to every response (e.g. "Show
# severity as bold text instead of emoji"). Seeds the JSON config blob in
# the storage account on first read (app/output_format_store.py) — after
# that, the blob is the source of truth and this value is ignored.
OUTPUT_FORMAT_INSTRUCTIONS=

# ── Microsoft Graph — channel thread context (optional) ──────────────────────
# Requires the Managed Identity above to be granted the Graph APPLICATION
# permission ChannelMessage.Read.All with tenant-admin consent (separate
# from the Bot Framework permissions used for send/receive). Channel-only —
# Teams has no thread concept for personal/group chats.
THREAD_CONTEXT_ENABLED=true
THREAD_CONTEXT_MESSAGE_COUNT=5

# Logging is hardcoded (plain text, INFO level) in app/logging_config.py —
# not configurable via environment. Container Apps captures stdout/stderr
# (PYTHONUNBUFFERED=1 in the Dockerfile ensures it streams immediately) into
# Log Analytics automatically.
