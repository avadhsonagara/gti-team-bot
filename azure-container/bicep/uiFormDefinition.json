{
  "$schema": "https://schema.management.azure.com/schemas/2021-09-09/uiFormDefinition.schema.json",
  "view": {
    "kind": "Form",
    "properties": {
      "title": "Deploy GTI Teams Bot (Agentic) — Container Apps",
      "steps": [
        {
          "name": "basics",
          "label": "Bot Configuration",
          "elements": [
            {
              "name": "resourceScope",
              "type": "Microsoft.Common.ResourceScope",
              "location": {
                "resourceTypes": [
                  "microsoft.resources/resourcegroups"
                ]
              }
            },
            {
              "name": "containerAppName",
              "type": "Microsoft.Common.TextBox",
              "label": "Container App Name",
              "toolTip": "Name of the Container App to create.",
              "defaultValue": "gti-teams-bot-agentic",
              "constraints": {
                "required": true,
                "regex": "",
                "validationMessage": ""
              },
              "visible": true
            },
            {
              "name": "gtiApiKey",
              "type": "Microsoft.Common.PasswordBox",
              "label": {
                "password": "GTI API Key"
              },
              "toolTip": "Google Threat Intelligence Agentic API key. Stored as a Key Vault secret, never as a plaintext env var.",
              "constraints": {
                "required": true
              },
              "options": {
                "hideConfirmation": true
              },
              "visible": true
            },
            {
              "name": "dedicatedWorkloadProfileType",
              "type": "Microsoft.Common.DropDown",
              "label": "Premium Ingress Workload Profile",
              "toolTip": "Dedicated workload profile SKU the environment's ingress (and the bot itself) runs on — this is what unlocks Premium ingress's configurable idle timeout.",
              "defaultValue": "D4",
              "constraints": {
                "required": true,
                "allowedValues": [
                  { "label": "D4 (4 vCPU, 16 GiB)", "value": "D4" },
                  { "label": "D8 (8 vCPU, 32 GiB)", "value": "D8" },
                  { "label": "D16 (16 vCPU, 64 GiB)", "value": "D16" },
                  { "label": "D32 (32 vCPU, 128 GiB)", "value": "D32" }
                ]
              },
              "visible": true
            },
            {
              "name": "premiumIngressIdleTimeoutMinutes",
              "type": "Microsoft.Common.TextBox",
              "label": "Premium Ingress Idle Timeout (minutes)",
              "toolTip": "Must comfortably exceed GTI Timeout Seconds below. Must be between 4 and 30.",
              "defaultValue": "15",
              "constraints": {
                "required": true,
                "regex": "^([4-9]|[12][0-9]|30)$",
                "validationMessage": "Enter a whole number between 4 and 30."
              },
              "visible": true
            },
            {
              "name": "gtiTimeoutSeconds",
              "type": "Microsoft.Common.TextBox",
              "label": "GTI Timeout Seconds",
              "toolTip": "Client-side read timeout (seconds) for a single GTI Agentic API call.",
              "defaultValue": "600",
              "constraints": {
                "required": true,
                "regex": "^([3-9][0-9]|[1-9][0-9]{2}|1[0-7][0-9]{2}|1800)$",
                "validationMessage": "Enter a whole number between 30 and 1800."
              },
              "visible": true
            },
            {
              "name": "botMinReplicas",
              "type": "Microsoft.Common.TextBox",
              "label": "Minimum Bot Replicas",
              "toolTip": "Minimum bot replicas. Keep at 2+ for spare capacity always available rather than scaling from zero.",
              "defaultValue": "1",
              "constraints": {
                "required": true,
                "regex": "^([0-9]|[1-9][0-9]|[1-2][0-9]{2}|300)$",
                "validationMessage": "Enter a whole number between 0 and 300."
              },
              "visible": true
            },
            {
              "name": "botMaxReplicas",
              "type": "Microsoft.Common.TextBox",
              "label": "Maximum Bot Replicas",
              "toolTip": "Maximum bot replicas.",
              "defaultValue": "10",
              "constraints": {
                "required": true,
                "regex": "^([1-9]|[1-9][0-9]|[1-2][0-9]{2}|300)$",
                "validationMessage": "Enter a whole number between 1 and 300."
              },
              "visible": true
            },
            {
              "name": "outputFormatInstructions",
              "type": "Microsoft.Common.TextBox",
              "label": "Output Format Instructions",
              "toolTip": "Optional formatting instructions applied to every bot response (e.g. \"Show severity as bold text instead of emoji\"). Leave empty to use the bot's built-in formatting.",
              "defaultValue": "",
              "constraints": {
                "required": false,
                "regex": "",
                "validationMessage": ""
              },
              "visible": true
            },
            {
              "name": "threadContextMessageCount",
              "type": "Microsoft.Common.TextBox",
              "label": "Thread Context Message Count",
              "toolTip": "Number of most-recent channel-thread messages to fetch as context for each query. No effect outside channels. Must be between 1 and 50.",
              "defaultValue": "5",
              "constraints": {
                "required": false,
                "regex": "^([1-9]|[1-4][0-9]|50)$",
                "validationMessage": "Enter a whole number between 1 and 50."
              },
              "visible": true
            }
          ]
        },
        {
          "name": "rsAlerts",
          "label": "RS Alerts (optional)",
          "elements": [
            {
              "name": "addRsAlerts",
              "type": "Microsoft.Common.DropDown",
              "label": "Add RS Alerts to this Team",
              "toolTip": "Provisions a background Function App that polls Google Threat Intelligence alerts and posts them into a Teams channel. Set to \"Yes\" to also fill in the fields below.",
              "defaultValue": "Yes",
              "constraints": {
                "required": false,
                "allowedValues": [
                  { "label": "No", "value": "No" },
                  { "label": "Yes", "value": "Yes" }
                ]
              },
              "visible": true
            },
            {
              "name": "rsAlertsFunctionAppName",
              "type": "Microsoft.Common.TextBox",
              "label": "RS Alerts Function App Name",
              "toolTip": "Name of the RS Alerts Function App.",
              "defaultValue": "gti-teams-bot-agentic-rs-alerts",
              "constraints": {
                "required": true,
                "regex": "",
                "validationMessage": ""
              },
              "visible": "[equals(steps('rsAlerts').addRsAlerts, 'Yes')]"
            },
            {
              "name": "rsAlertsHostingPlanType",
              "type": "Microsoft.Common.DropDown",
              "label": "RS Alerts Hosting Plan",
              "toolTip": "Consumption (classic, scale-to-zero) or Flex Consumption (modern serverless with configurable memory). Premium is not offered here.",
              "defaultValue": "Consumption",
              "constraints": {
                "required": true,
                "allowedValues": [
                  { "label": "Consumption", "value": "Consumption" },
                  { "label": "Flex Consumption", "value": "FlexConsumption" }
                ]
              },
              "visible": "[equals(steps('rsAlerts').addRsAlerts, 'Yes')]"
            },
            {
              "name": "rsAlertsInstanceMemoryMB",
              "type": "Microsoft.Common.DropDown",
              "label": "RS Alerts Function Instance Memory MB",
              "toolTip": "Per-instance memory for the RS Alerts Flex Consumption plan.",
              "defaultValue": 512,
              "constraints": {
                "required": true,
                "allowedValues": [
                  { "label": "512", "value": 512 },
                  { "label": "2048", "value": 2048 },
                  { "label": "4096", "value": 4096 }
                ]
              },
              "visible": "[and(equals(steps('rsAlerts').addRsAlerts, 'Yes'), equals(steps('rsAlerts').rsAlertsHostingPlanType, 'FlexConsumption'))]"
            },
            {
              "name": "rsAlertsChannelIdOrChannelLink",
              "type": "Microsoft.Common.TextBox",
              "label": "RS Alerts Teams Channel Link",
              "toolTip": "Paste the FULL channel link (right-click the channel -> Get link to channel) — the full link is required so the bot's Teams app can be auto-installed into the team via Microsoft Graph.",
              "defaultValue": "",
              "constraints": {
                "required": true,
                "regex": "",
                "validationMessage": ""
              },
              "visible": "[equals(steps('rsAlerts').addRsAlerts, 'Yes')]"
            },
            {
              "name": "rsAlertsGtiProject",
              "type": "Microsoft.Common.TextBox",
              "label": "RS Alert Project ID",
              "toolTip": "GTI project ID for RS Alerts, from the Alerts URL (...&project=projects/<id>).",
              "defaultValue": "",
              "constraints": {
                "required": true,
                "regex": "",
                "validationMessage": ""
              },
              "visible": "[equals(steps('rsAlerts').addRsAlerts, 'Yes')]"
            },
            {
              "name": "rsAlertsBackfillDays",
              "type": "Microsoft.Common.TextBox",
              "label": "RS Alerts Backfill Days",
              "toolTip": "Backfill window (days) used to seed the cursor on RS Alerts' very first run, instead of the project's entire history. Must be between 1 and 7.",
              "defaultValue": "7",
              "constraints": {
                "required": true,
                "regex": "^[1-7]$",
                "validationMessage": "Enter a whole number between 1 and 7."
              },
              "visible": "[equals(steps('rsAlerts').addRsAlerts, 'Yes')]"
            },
            {
              "name": "rsAlertsFilterSeverityLevel",
              "type": "Microsoft.Common.TextBox",
              "label": "RS Alerts Filter: Severity Level",
              "toolTip": "Comma-separated LOW/MEDIUM/HIGH. Must resolve to at least one value.",
              "defaultValue": "MEDIUM,HIGH",
              "constraints": {
                "required": true,
                "regex": "",
                "validationMessage": ""
              },
              "visible": "[equals(steps('rsAlerts').addRsAlerts, 'Yes')]"
            },
            {
              "name": "rsAlertsFilterPriorityLevel",
              "type": "Microsoft.Common.TextBox",
              "label": "RS Alerts Filter: Priority Level",
              "toolTip": "Comma-separated LOW/MEDIUM/HIGH/CRITICAL. Must resolve to at least one value.",
              "defaultValue": "MEDIUM,HIGH,CRITICAL",
              "constraints": {
                "required": true,
                "regex": "",
                "validationMessage": ""
              },
              "visible": "[equals(steps('rsAlerts').addRsAlerts, 'Yes')]"
            },
            {
              "name": "rsAlertsFilterRelevanceLevel",
              "type": "Microsoft.Common.TextBox",
              "label": "RS Alerts Filter: Relevance Level",
              "toolTip": "Comma-separated LOW/MEDIUM/HIGH. Must resolve to at least one value.",
              "defaultValue": "MEDIUM,HIGH",
              "constraints": {
                "required": true,
                "regex": "",
                "validationMessage": ""
              },
              "visible": "[equals(steps('rsAlerts').addRsAlerts, 'Yes')]"
            },
            {
              "name": "rsAlertsFilterRelevanceConfidence",
              "type": "Microsoft.Common.TextBox",
              "label": "RS Alerts Filter: Relevance Confidence",
              "toolTip": "Comma-separated LOW/MEDIUM/HIGH. Must resolve to at least one value.",
              "defaultValue": "MEDIUM,HIGH",
              "constraints": {
                "required": true,
                "regex": "",
                "validationMessage": ""
              },
              "visible": "[equals(steps('rsAlerts').addRsAlerts, 'Yes')]"
            }
          ]
        }
      ]
    },
    "outputs": {
      "kind": "ResourceGroup",
      "location": "[steps('basics').resourceScope.location.name]",
      "resourceGroupId": "[steps('basics').resourceScope.resourceGroup.id]",
      "parameters": {
        "containerAppName": "[steps('basics').containerAppName]",
        "gtiApiKey": "[steps('basics').gtiApiKey]",
        "dedicatedWorkloadProfileType": "[steps('basics').dedicatedWorkloadProfileType]",
        "premiumIngressIdleTimeoutMinutes": "[int(steps('basics').premiumIngressIdleTimeoutMinutes)]",
        "gtiTimeoutSeconds": "[int(steps('basics').gtiTimeoutSeconds)]",
        "botMinReplicas": "[int(steps('basics').botMinReplicas)]",
        "botMaxReplicas": "[int(steps('basics').botMaxReplicas)]",
        "outputFormatInstructions": "[steps('basics').outputFormatInstructions]",
        "threadContextMessageCount": "[int(steps('basics').threadContextMessageCount)]",
        "addRsAlerts": "[steps('rsAlerts').addRsAlerts]",
        "rsAlertsFunctionAppName": "[steps('rsAlerts').rsAlertsFunctionAppName]",
        "rsAlertsHostingPlanType": "[steps('rsAlerts').rsAlertsHostingPlanType]",
        "rsAlertsInstanceMemoryMB": "[steps('rsAlerts').rsAlertsInstanceMemoryMB]",
        "rsAlertsChannelIdOrChannelLink": "[steps('rsAlerts').rsAlertsChannelIdOrChannelLink]",
        "rsAlertsGtiProject": "[steps('rsAlerts').rsAlertsGtiProject]",
        "rsAlertsBackfillDays": "[int(steps('rsAlerts').rsAlertsBackfillDays)]",
        "rsAlertsFilterSeverityLevel": "[steps('rsAlerts').rsAlertsFilterSeverityLevel]",
        "rsAlertsFilterPriorityLevel": "[steps('rsAlerts').rsAlertsFilterPriorityLevel]",
        "rsAlertsFilterRelevanceLevel": "[steps('rsAlerts').rsAlertsFilterRelevanceLevel]",
        "rsAlertsFilterRelevanceConfidence": "[steps('rsAlerts').rsAlertsFilterRelevanceConfidence]"
      }
    }
  }
}
