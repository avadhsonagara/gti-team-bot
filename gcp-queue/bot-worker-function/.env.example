# =============================================================================
# GTI Teams Bot (Agentic) — Worker Function — Environment Configuration
# =============================================================================
# REQUIRED settings have no usable default — this function will fail (either
# at cold start or on the first job) if left unset. Everything else has a
# working default and only needs to be set to override it.
# =============================================================================

# ── Microsoft Teams / Bot Framework — REQUIRED ───────────────────────────────
# Must be the SAME app registration bot-ingest-function/.env uses — both
# Cloud Functions authenticate as one bot. Also used to recognize the bot's
# own placeholder messages in channel thread history
# (app/teams/thread.py::is_placeholder_message).
CLIENT_ID=your-microsoft-app-client-id
CLIENT_SECRET=your-microsoft-app-client-secret
TENANT_ID=your-microsoft-entra-tenant-id

# ── Google Threat Intelligence (GTI) Agentic API — REQUIRED ──────────────────
GTI_API_KEY=your-gti-virustotal-api-key
GTI_API_BASE_URL=https://www.virustotal.com/api/v3

# Read timeout (seconds) for a single GTI Agentic API call. A Pub/Sub push
# subscription's ack_deadline_seconds has a hard 600s (10 min) ceiling with
# no lease-renewal available to a push endpoint (see terraform/main.tf's
# job_subscription and the README's "Timeout budget" section) — this default
# leaves ~120s of headroom under that ceiling for attachment downloads,
# thread-context fetch, delivery, and cold start. Raise this only together
# with ack_deadline_seconds and service_config.timeout_seconds in Terraform —
# 600s is a true platform ceiling, not a quota that can be lifted.
GTI_TIMEOUT_SECONDS=480

# ── Google Cloud Platform & Firestore Configuration ──────────────────────────
# On Cloud Run functions, Firestore and Google Cloud APIs authenticate
# automatically via Application Default Credentials (ADC) and the attached
# service account, and GCP_PROJECT_ID is populated automatically from the
# runtime environment. For local testing, run
# `gcloud auth application-default login` and set GCP_PROJECT_ID explicitly.
GCP_PROJECT_ID=your-gcp-project-id
FIRESTORE_DATABASE=(default)
# Bot config (output-format doc), per-thread GTI session documents, and
# redelivery dedup claims (app/dedup_store.py) all live in this one
# collection — see app/output_format_store.py and app/gti/session_store.py.
FIRESTORE_BOT_CONFIG_COLLECTION=gti-bot-config
FIRESTORE_OUTPUT_FORMAT_DOC=gti-custom-output-format

# ── Job hand-off from the Ingest Cloud Function (optional) ───────────────────
# A pushed job older than this (seconds, measured from the job's own
# enqueuedAt field) is treated as stale — the placeholder is updated to say
# so instead of running an expensive GTI query for a request that old.
MAX_JOB_AGE_SECONDS=480

# ── Output format instructions (optional) ────────────────────────────────────
OUTPUT_FORMAT_INSTRUCTIONS=

# ── Microsoft Graph — channel thread context (optional) ──────────────────────
# Requires the CLIENT_ID app registration to be granted the Graph APPLICATION
# permission ChannelMessage.Read.All with tenant-admin consent. Channel-only —
# Teams has no thread concept for personal/group chats. A second message in
# the same channel thread also reuses its GTI session (see
# FIRESTORE_BOT_CONFIG_COLLECTION above) instead of starting a fresh one.
THREAD_CONTEXT_ENABLED=true
THREAD_CONTEXT_MESSAGE_COUNT=5

# ── HTTP connection pool sizing (optional) ───────────────────────────────────
# Matches terraform/main.tf's var.worker_concurrency (also drives
# PYTHON_THREADPOOL_THREAD_COUNT). Set automatically when deployed via
# Terraform — only needs setting by hand for local/manual runs.
# THREADS=15

# Logging is hardcoded in app/logging_config.py — not configurable via
# environment.
