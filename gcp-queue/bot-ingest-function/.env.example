# =============================================================================
# GTI Teams Bot (Agentic) — Ingest Function — Environment Configuration
# =============================================================================
# REQUIRED settings have no usable default — this function will fail (either
# at cold start or on the first message) if left unset. Everything else has
# a working default and only needs to be set to override it.
# =============================================================================

# ── Microsoft Teams / Bot Framework Authentication — REQUIRED ────────────────
# Must be the SAME app registration bot-worker-function/.env uses — both
# Cloud Functions authenticate as one bot.
CLIENT_ID=your-microsoft-app-client-id
CLIENT_SECRET=your-microsoft-app-client-secret
TENANT_ID=your-microsoft-entra-tenant-id

# ── Pub/Sub hand-off to the Worker Cloud Function — REQUIRED (GCP_PROJECT_ID) ─
# On Cloud Run functions, GCP_PROJECT_ID is populated automatically from the
# runtime environment. For local testing, run
# `gcloud auth application-default login` and set it explicitly. PUBSUB_TOPIC
# must match the topic name terraform/main.tf provisions (default shown).
GCP_PROJECT_ID=your-gcp-project-id
PUBSUB_TOPIC=gti-query-jobs

# ── Safety guards (optional — sane defaults shown) ────────────────────────────
# MAX_JOB_PAYLOAD_BYTES=49152
# MAX_REQUEST_BODY_BYTES=1048576

# ── HTTP connection pool sizing (optional) ───────────────────────────────────
# Matches terraform/main.tf's var.ingest_concurrency (also drives
# PYTHON_THREADPOOL_THREAD_COUNT) so app/teams/bot_client.py's connection
# pool can hold one connection per concurrent request, instead of urllib3's
# default pool size of 10. Set automatically when deployed via Terraform —
# only needs setting by hand for local/manual runs.
# THREADS=20

# Logging is hardcoded in app/logging_config.py — not configurable via
# environment. It auto-detects JSON (Cloud Logging) vs plain text based on
# whether K_SERVICE/FUNCTION_TARGET are set (i.e. running on GCP vs local).

# Functions Framework itself reads PORT for local `functions-framework
# --port=...` runs; it isn't read by any code in this app.
