{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "functionAppName": {
      "value": "gti-team-bot"
    },
    "location": {
      "value": "canadacentral"
    },
    "pythonVersion": {
      "value": "3.12"
    },
    "instanceMemoryMB": {
      "value": 2048
    },
    "maximumInstanceCount": {
      "value": 100
    },
    "appSettings": {
      "value": {
        "GTI_API_BASE_URL": "https://www.virustotal.com/api/v3",
        "GTI_TIMEOUT_SECONDS": "180.0",
        "GTI_MAX_RETRIES": "2",
        "GTI_RETRY_DELAY": "2.0",
        "LOG_FORMAT": "text"
      }
    },
    "manifestContainerName": {
      "value": "teams-manifest"
    },
    "manifestBlobName": {
      "value": "teams-app-manifest.zip"
    },
    "outputFormatInstructions": {
      "value": ""
    },
    "enableRsAlerts": {
      "value": false
    },
    "rsAlertsTeamsChannelId": {
      "value": ""
    },
    "rsAlertsGtiProject": {
      "value": ""
    },
    "rsAlertsSchedule": {
      "value": "0 */15 * * * *"
    },
    "tags": {
      "value": {
        "app": "gti-team-bot",
        "managedBy": "bicep"
      }
    }
  }
}
