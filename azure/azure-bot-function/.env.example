# =============================================================================
# GTI Teams Bot (Agentic) — Azure Functions Environment Configuration
# =============================================================================
# For local development with `func start`, put these values into the
# "Values" object in local.settings.json instead — Azure Functions Core
# Tools does not read a .env file. This file documents the same settings
# for reference, and is used if you run a script directly with `python`.
#
# REQUIRED settings have no usable default — the bot will fail (either at
# cold start or on the first message) if they're left unset. Everything else
# has a working default and only needs to be set to override it.
# =============================================================================

# ── Microsoft Teams / Bot Framework (Azure Bot registration) — REQUIRED ───────
# Verifies inbound Teams activities (app/teams/auth.py) and authenticates
# outbound calls to the Bot Framework Connector API and Microsoft Graph
# (app/teams/bot_client.py, app/graph/client.py) — hand-rolled against the
# Bot Framework REST APIs directly, no SDK. Both settings are set
# automatically by azure/infra/main.bicep to the same User-Assigned Managed
# Identity's client ID — there is no client-secret path in this codebase.
CLIENT_ID=your-managed-identity-client-id-here
MANAGED_IDENTITY_CLIENT_ID=your-managed-identity-client-id-here

# ── Google Threat Intelligence (GTI) Agentic API — REQUIRED ───────────────────
# Authenticates requests via the x-apikey header to /agentspace/sessions.
GTI_API_KEY=your-gti-api-key-here

# ── Storage (Blob + Table) — REQUIRED for output-format & session persistence ─
# Backs app/output_format_store.py (response formatting override) and
# app/gti/session_store.py (per-thread GTI session continuity). Azure
# Functions provides this automatically in `func start` and when deployed —
# only set it manually if running a script outside the Functions host.
# AzureWebJobsStorage=

# ── Output format instructions (optional) ──────────────────────────────────────
# Optional formatting instructions applied to every response (e.g. "Show
# severity as bold text instead of emoji"). Seeds the JSON config blob in
# this app's storage account on first read (app/output_format_store.py) —
# after that, the blob is the source of truth and this value is ignored.
OUTPUT_FORMAT_INSTRUCTIONS=

# ── Microsoft Graph — channel thread context (optional) ──────────────────────
# Requires the Managed Identity above to be granted the Graph APPLICATION
# permission ChannelMessage.Read.All with tenant-admin consent (separate
# from the Bot Framework permissions used for send/receive). Channel-only —
# Teams has no thread concept for personal/group chats. A second message in
# the same channel thread also reuses its GTI session (see
# app/gti/session_store.py above) instead of starting a fresh one.
THREAD_CONTEXT_ENABLED=true
THREAD_CONTEXT_MESSAGE_COUNT=5

# Logging is hardcoded (plain text, INFO level) in app/logging_config.py —
# not configurable via environment. Azure Functions forwards it to
# Application Insights automatically.
