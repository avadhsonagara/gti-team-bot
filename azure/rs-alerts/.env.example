# =============================================================================
# RS Alerts (GTI Alerts -> Microsoft Teams) — Azure Functions Environment
# =============================================================================
# For local development with `func start`, put these values into the
# "Values" object in local.settings.json instead — Azure Functions Core
# Tools does not read a .env file. This file documents the same settings
# for reference, and is used if you run the job directly outside `func start`.
#
# REQUIRED settings have no usable default — run_job() raises and aborts at
# startup if any are left unset. Everything else has a working default and
# only needs to be set to override it.
# =============================================================================

# ── Bot Framework identity — REQUIRED (one of the two options below) ─────────
# In Azure, leave CLIENT_SECRET empty and set MANAGED_IDENTITY_CLIENT_ID to
# the bot's User-Assigned Managed Identity client ID instead (see
# infra/main.bicep) — no client secret is used in production. This same
# identity is also used to call Microsoft Graph for Teams app auto-install
# (see below) — it needs the TeamsAppInstallation.ReadWriteForTeam.All
# application permission granted with admin consent for that to work.
CLIENT_ID=your-microsoft-app-id-here
CLIENT_SECRET=your-microsoft-app-password-here
TENANT_ID=your-entra-tenant-id-here
MANAGED_IDENTITY_CLIENT_ID=

# ── Microsoft Teams target — REQUIRED ─────────────────────────────────────────
# In Teams: right-click the target channel -> "Get link to channel" -> paste it here.
# The FULL link is required (https://teams.microsoft.com/l/channel/19%3a...
# ...?groupId=...) — the groupId query parameter is the team's id, which is
# used to automatically install the bot's Teams app into that team via
# Microsoft Graph (app/graph_client.py) so nobody has to manually click
# "Add" in the Teams UI. A bare channel ID (19:xxx@thread.tacv2) still works
# for message delivery, but auto-install is silently skipped since a bare
# ID doesn't carry the team id — the bot would then need to already be a
# member of that team.
# One-time setup for auto-install to work (not required for basic delivery
# if the bot is already added to the team manually):
#   1. Upload the bot's Teams app to the org's app catalog once, via Teams
#      Admin Center or POST /appCatalogs/teamsApps.
#   2. Grant the identity above TeamsAppInstallation.ReadWriteForTeam.All
#      (application permission) with admin consent in Entra ID.
TEAMS_CHANNEL_ID=https://teams.microsoft.com/l/channel/19%3aXXX%40thread.tacv2/my-channel?groupId=...
# SERVICE_URL=https://smba.trafficmanager.net/amer/

# ── Google Threat Intelligence (GTI) Alerts API — REQUIRED ───────────────────
GTI_API_KEY=your-gti-api-key-here
# GTI project ID: copy from the Alerts URL -> ...&project=projects/<id>.
# This is the GTI-side project being queried for alerts — it is NOT
# necessarily the same as any Azure/GCP resource IDs and has no fallback;
# leaving it unset fails the job at startup rather than silently querying
# the wrong project.
GTI_RSA_PROJECT=your-gti-project-id-here

# Optional tuning — defaults shown.
# BACKFILL_DAYS=7
# PAGE_SIZE=1000

# ── Optional Alert Filters (comma-separated, defaults shown) ──────────────
# FILTER_SEVERITY_LEVEL=MEDIUM,HIGH
# FILTER_PRIORITY_LEVEL=MEDIUM,HIGH,CRITICAL
# FILTER_RELEVANCE_LEVEL=MEDIUM,HIGH
# FILTER_RELEVANCE_CONFIDENCE=MEDIUM,HIGH

# ── Timer schedule (NCRONTAB, optional) ───────────────────────────────────────
# RS_ALERTS_SCHEDULE=0 */15 * * * *

# ── Cursor state (Azure Blob Storage) — REQUIRED ─────────────────────────────
# AzureWebJobsStorage is provided automatically by Azure Functions / func start
# — only set it manually if running the job outside the Functions host.
# AzureWebJobsStorage=
# STATE_CONTAINER_NAME=rs-alerts-state
# STATE_BLOB_NAME=cursor.json

# Logging is hardcoded (plain text, INFO level) in app/logging_config.py —
# not configurable via environment.
