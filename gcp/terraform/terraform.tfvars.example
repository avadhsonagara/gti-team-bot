# =============================================================================
# GTI Teams Bot (Agentic) — GCP Terraform Variables Example
# =============================================================================
# Copy this file to terraform.tfvars and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars
# =============================================================================

project_id = "provide_your_project_id"
region     = "us-central1"
bot_name   = "gti-team-bot"

# Optional override (default is derived from bot_name/project_id plus a random suffix)
# storage_bucket_name = "your-project-id-gti-team-bot-storage-xxxx"  # must be globally unique


# Google Threat Intelligence API Key
gti_api_key = "YOUR_GTI_VIRUSTOTAL_API_KEY"

# Optional: Custom bot formatting instructions
output_format_instructions = ""

# ── Optional: RS Alerts (Background GTI Alerts -> Teams) ─────────────────────
# Pass the FULL channel link (not a bare ID) so the bot's Teams app can be
# auto-installed into the team via Microsoft Graph.
enable_rs_alerts                   = false
rs_alerts_teams_channel_id_or_link = "https://teams.microsoft.com/l/channel/19%3aexampleChannelId%40thread.tacv2/my-channel?groupId=00000000-0000-0000-0000-000000000000&tenantId=00000000-0000-0000-0000-000000000000"

# GTI project ID for RS Alerts, from the Alerts URL (...&project=projects/<id>).
# This is the GTI-side project being queried for alerts — it is NOT
# necessarily the same as project_id above and has no fallback to it.
# Required when enable_rs_alerts is true.
rsa_gti_project = "YOUR_GTI_PROJECT_ID"

# Optional RSA tuning (defaults shown)
# rsa_function_name            = "gti-alerts-fetch"
# rsa_schedule                 = "*/3 * * * *"   # every 3 minutes
# rsa_schedule_timezone        = "Etc/UTC"
# rsa_page_size                = 1000
# rsa_function_memory          = "256Mi"
# rsa_function_timeout_seconds = 540

# Optional RSA alert filters (comma-separated, OR'd within a field, AND'd
# across fields). Defaults shown filter out LOW noise; set a field to ""
# to disable filtering on that dimension (every alert passes).
# rsa_filter_severity_level       = "MEDIUM,HIGH"            # valid: LOW, MEDIUM, HIGH
# rsa_filter_priority_level       = "MEDIUM,HIGH,CRITICAL"   # valid: LOW, MEDIUM, HIGH, CRITICAL
# rsa_filter_relevance_level      = "MEDIUM,HIGH"            # valid: LOW, MEDIUM, HIGH
# rsa_filter_relevance_confidence = "MEDIUM,HIGH"            # valid: LOW, MEDIUM, HIGH
