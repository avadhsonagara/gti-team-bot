# =============================================================================
# GTI Teams Bot (Agentic) — GCP Terraform Variables Example
# =============================================================================
# Copy this file to terraform.tfvars and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars
# =============================================================================

# ── Required Settings ────────────────────────────────────────────────────────

# Google Cloud Project ID where all resources will be created.
project_id = "provide_your_project_id"

# Google Cloud region for all resources (Cloud Run, GCS, Firestore, Secrets).
region = "us-central1"

# Base resource name for the bot application.
bot_name = "gti-team-bot"

# Google Threat Intelligence / VirusTotal API key. Stored securely in Secret Manager.
gti_api_key = "YOUR_GTI_VIRUSTOTAL_API_KEY"

# Name of an EXISTING Azure resource group to deploy the Bot Service into
# (REQUIRED). Leave empty to create a new resource group named
# '<bot_name>-rg' — creating a resource group requires subscription-level
# permission, which the deploying identity may not have if its access is
# scoped to a single existing resource group.
azure_resource_group_name = "YOUR_AZURE_RESOURCE_GROUP_NAME"

# ── Optional: Naming overrides ────────────────────────────────────────────────

# Globally-unique name for the Azure Bot Service resource (Bot Service names
# are unique across all of Azure, not just this subscription). Empty =
# derive from bot_name plus a random suffix.
# azure_bot_name = "your-custom-azure-bot-name"

# Globally-unique GCS bucket name for source code and manifests. Empty =
# derive from project_id/bot_name plus a random suffix.
# storage_bucket_name = "your-globally-unique-bucket-name"

# ── gti-bot Cloud Run Sizing & Concurrency Tuning (optional) ─────────────────
# gti-bot deploys as a Cloud Run v2 service (see main.tf), built from
# gcp/gti-bot/Dockerfile and pushed straight to Docker Hub — see the
# null_resource.gti_bot_image_build image reference in main.tf if you're
# using a different Docker Hub account/repo than the one hardcoded there.

concurrency = 10
memory = "1Gi"
timeout_seconds = 300
max_instances = 1
min_instances = 0

# ── Output formatting (optional) ──────────────────────────────────────────────

# Optional custom formatting instructions applied to every bot response
# (seeds the Firestore document on first read).
output_format_instructions = ""

# ── Microsoft Graph — channel thread context (optional) ──────────────────────
# Requires the bot's Entra app registration to be granted the Graph
# APPLICATION permission ChannelMessage.Read.All with tenant-admin consent —
# a manual one-time step, separate from the Bot Framework permissions it
# already has. Channel-only — Teams has no thread concept for personal/group
# chats. Enabled by default in code (app/config.py); this only tunes how many
# prior messages get fetched as context for each query.
thread_context_message_count = 5

# ── Optional: RS Alerts (Background GTI Alerts -> Teams) ─────────────────────

# Set to true to provision the RS Alerts background function and Cloud
# Scheduler trigger.
enable_rs_alerts = false

# Teams channel link or ID (19:...@thread.tacv2) that RS Alerts posts GTI
# alerts into. Pass the FULL channel link (not a bare ID) so the bot's Teams
# app can be auto-installed into the team via Microsoft Graph. Required when
# enable_rs_alerts is true.
rs_alerts_teams_channel_id_or_link = "https://teams.microsoft.com/l/channel/19%3aexampleChannelId%40thread.tacv2/my-channel?groupId=00000000-0000-0000-0000-000000000000&tenantId=00000000-0000-0000-0000-000000000000"

# Google Threat Intelligence project ID that RS Alerts queries for alerts.
# This is a GTI-side project, not necessarily the same as project_id above
# and has no fallback to it. Required when enable_rs_alerts is true.
rsa_gti_project = "YOUR_GTI_PROJECT_ID"

# Optional RSA tuning (defaults shown)
# rsa_function_name            = "gti-alerts-fetch"    # Name of the RS Alerts Cloud Run function.
# rsa_schedule                 = "*/3 * * * *"          # Cron expression for the Cloud Scheduler job (every 3 minutes).
# rsa_schedule_timezone        = "Etc/UTC"              # Timezone for the Cloud Scheduler job.
# rsa_page_size                = 1000                   # Page size for GTI Alerts API pagination.
# rsa_function_memory          = "256Mi"                # Memory allocated to the RS Alerts Cloud Run function.
# rsa_function_timeout_seconds = 540                    # Execution timeout in seconds for the RS Alerts Cloud Run function.

# Optional RSA alert filters (comma-separated, OR'd within a field, AND'd
# across fields). Defaults shown filter out LOW noise; set a field to ""
# to disable filtering on that dimension (every alert passes).
# rsa_filter_severity_level       = "MEDIUM,HIGH"            # valid: LOW, MEDIUM, HIGH
# rsa_filter_priority_level       = "MEDIUM,HIGH,CRITICAL"   # valid: LOW, MEDIUM, HIGH, CRITICAL
# rsa_filter_relevance_level      = "MEDIUM,HIGH"            # valid: LOW, MEDIUM, HIGH
# rsa_filter_relevance_confidence = "MEDIUM,HIGH"            # valid: LOW, MEDIUM, HIGH