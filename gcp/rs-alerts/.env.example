# =============================================================================
# RS Alerts (GTI Alerts -> Microsoft Teams) — GCP Environment Variables
# =============================================================================
# REQUIRED settings have no usable default — run_job() raises and aborts at
# startup if any are left unset. Everything else has a working default and
# only needs to be set to override it.
# =============================================================================

# ── Microsoft Teams delivery — REQUIRED ───────────────────────────────────────
# RS Alerts posts via a Teams incoming webhook (Workflows/Power Automate),
# not the bot itself — no Azure AD credentials or bot team-membership needed.
# In Teams: target channel -> Workflows -> "Post to a channel when a webhook
# request is received" -> Save -> copy the webhook URL it generates.
# This URL is a bearer credential (anyone with it can post to the channel) —
# treat it like a secret.
RS_ALERTS_WEBHOOK_URL=https://.../workflows/.../triggers/manual/paths/invoke?api-version=1&sp=...&sv=1.0&sig=...

# ── Google Threat Intelligence Alerts API — REQUIRED ─────────────────────────
GTI_API_KEY=your-gti-virustotal-api-key
# GTI project ID: copy from the Alerts URL -> ...&project=projects/<id>.
# This is the GTI-side project being queried for alerts — it is NOT
# necessarily the same as GCP_PROJECT_ID below and has no fallback to it;
# leaving it unset fails the job at startup rather than silently querying
# the wrong project.
GTI_RSA_PROJECT=your-gti-project-id-here

# Optional tuning — defaults shown.
BACKFILL_DAYS=7
PAGE_SIZE=1000

# ── Alert Filters (comma-separated uppercase values, optional) ───────────────
FILTER_SEVERITY_LEVEL=MEDIUM,HIGH
FILTER_PRIORITY_LEVEL=MEDIUM,HIGH,CRITICAL
FILTER_RELEVANCE_LEVEL=MEDIUM,HIGH
FILTER_RELEVANCE_CONFIDENCE=MEDIUM,HIGH

# ── Google Cloud Platform & Firestore Configuration (optional) ───────────────
# In Cloud Run functions, Firestore and Google Cloud APIs authenticate automatically
# via Application Default Credentials (ADC) and the attached User-Assigned Service Account,
# and GCP_PROJECT_ID is populated automatically from the runtime environment.
# For local testing, run `gcloud auth application-default login` and set
# GCP_PROJECT_ID explicitly.
GCP_PROJECT_ID=gtimsteamaiintegration-3898
FIRESTORE_DATABASE=(default)
FIRESTORE_STATE_COLLECTION=rs-alerts-state
FIRESTORE_STATE_DOC=cursor

# Logging is hardcoded in app/logging_config.py — not configurable via
# environment. It auto-detects JSON (Cloud Logging) vs plain text based on
# whether K_SERVICE/FUNCTION_TARGET are set (i.e. running on GCP vs local).
