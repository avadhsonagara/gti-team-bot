# =============================================================================
# GTI Teams Bot (Agentic) — GCP Environment Variables
# =============================================================================
# REQUIRED settings have no usable default — the bot will fail (either at
# startup or on the first message) if they're left unset. Everything else
# has a working default and only needs to be set to override it.
# =============================================================================

# ── Microsoft Teams / Bot Framework Authentication — REQUIRED ────────────────
# Authenticates outbound calls to the Bot Framework Connector API and verifies
# inbound Teams activities via the Microsoft Teams SDK's FastAPIAdapter.
CLIENT_ID=your-microsoft-app-client-id
CLIENT_SECRET=your-microsoft-app-client-secret
TENANT_ID=your-microsoft-entra-tenant-id

# ── Google Threat Intelligence API Key — REQUIRED ────────────────────────────
GTI_API_KEY=your-gti-virustotal-api-key

# Optional GTI tuning — default shown. Timeout/retry/backoff are hardcoded
# in app/gti/client.py, not configurable via environment.
GTI_API_BASE_URL=https://www.virustotal.com/api/v3

# ── Google Cloud Platform & Firestore Configuration (optional) ───────────────
# In Cloud Run functions, Firestore and Google Cloud APIs authenticate automatically
# via Application Default Credentials (ADC) and the attached User-Assigned Service Account,
# and GCP_PROJECT_ID is populated automatically from the runtime environment.
# For local testing, run `gcloud auth application-default login` and set
# GCP_PROJECT_ID explicitly.
GCP_PROJECT_ID=gtimsteamaiintegration-3898
FIRESTORE_DATABASE=(default)
FIRESTORE_BOT_CONFIG_COLLECTION=bot-config
FIRESTORE_OUTPUT_FORMAT_DOC=output-format

# ── Output format instructions (optional) ────────────────────────────────────
# Deploy-time default that seeds the Firestore document on first read.
# Leave empty to use the built-in system prompt formatting from app/prompt.md.
OUTPUT_FORMAT_INSTRUCTIONS=

# ── Server (optional) ─────────────────────────────────────────────────────────
# SSL_KEYFILE / SSL_CERTFILE are only used by main.py's `uvicorn.run()`
# fallback (direct `python main.py` execution) — Cloud Run terminates TLS
# itself, so they have no effect when deployed.
PORT=8080
# SSL_KEYFILE=
# SSL_CERTFILE=

# Logging is hardcoded in app/logging_config.py — not configurable via
# environment. It auto-detects JSON (Cloud Logging) vs plain text based on
# whether K_SERVICE/FUNCTION_TARGET are set (i.e. running on GCP vs local).
