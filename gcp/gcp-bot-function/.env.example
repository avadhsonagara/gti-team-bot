# =============================================================================
# GTI Teams Bot (Agentic) — GCP Cloud Run function Environment Variables
# =============================================================================
# REQUIRED settings have no usable default — the bot will fail (either at
# cold start or on the first message) if they're left unset. Everything else
# has a working default and only needs to be set to override it.
# =============================================================================

# ── Microsoft Teams / Bot Framework Authentication — REQUIRED ────────────────
# Authenticates outbound calls to the Bot Framework Connector API and verifies
# inbound Teams activities (app/teams/auth.py, app/teams/bot_client.py) —
# hand-rolled against the Bot Framework REST APIs directly, no SDK.
CLIENT_ID=your-microsoft-app-client-id
CLIENT_SECRET=your-microsoft-app-client-secret
TENANT_ID=your-microsoft-entra-tenant-id

# ── Google Threat Intelligence API — REQUIRED ────────────────────────────────
# No code-level default for GTI_API_BASE_URL — it must be set here (or by
# Terraform, which always supplies it).
GTI_API_KEY=your-gti-virustotal-api-key
GTI_API_BASE_URL=https://www.virustotal.com/api/v3

# Optional GTI tuning — default shown. Retry/backoff counts are hardcoded
# in app/gti/client.py, not configurable via environment.
# GTI_TIMEOUT_SECONDS is the read timeout for a single GTI Agentic API call.
GTI_TIMEOUT_SECONDS=480

# ── Google Cloud Platform & Firestore Configuration (optional) ───────────────
# On Cloud Run functions, Firestore and Google Cloud APIs authenticate
# automatically via Application Default Credentials (ADC) and the attached
# service account, and GCP_PROJECT_ID is populated automatically from the
# runtime environment. For local testing, run
# `gcloud auth application-default login` and set GCP_PROJECT_ID explicitly.
GCP_PROJECT_ID=your-gcp-project-id
FIRESTORE_DATABASE=(default)
# Bot config (output-format doc) and per-thread GTI session documents both
# live in this one collection — see app/output_format_store.py and
# app/gti/session_store.py.
FIRESTORE_BOT_CONFIG_COLLECTION=gti-bot-config
FIRESTORE_OUTPUT_FORMAT_DOC=gti-custom-output-format

# ── Output format instructions (optional) ────────────────────────────────────
# Deploy-time default that seeds the Firestore document on first read.
# Leave empty to use the built-in system prompt formatting from app/gti/prompt.md.
OUTPUT_FORMAT_INSTRUCTIONS=

# ── Microsoft Graph — channel thread context ──────────────────────────────────
# Requires the CLIENT_ID app registration to be granted the Graph APPLICATION
# permission ChannelMessage.Read.All with tenant-admin consent (separate from
# the Bot Framework permissions used for send/receive). Channel-only — Teams
# has no thread concept for personal/group chats. A second message in the
# same channel thread also reuses its GTI session (see
# FIRESTORE_BOT_CONFIG_COLLECTION above) instead of starting a fresh one.
THREAD_CONTEXT_MESSAGE_COUNT=5

# ── HTTP connection pool sizing (optional) ───────────────────────────────────
# Reuses THREADS — the same env var terraform/main.tf already sets from
# var.concurrency (Cloud Run's max_instance_request_concurrency) — so the Bot
# Framework Connector/GTI/Graph clients' connection pools can hold one
# connection per concurrent request this instance is actually given, instead
# of urllib3's default pool size of 10. Set automatically when deployed via
# Terraform — only needs setting by hand for local/manual runs.
THREADS=40

# ── Inbound request guard (optional) ─────────────────────────────────────────
# /api/messages is publicly reachable (--allow-unauthenticated — the bot's
# own Bearer-token check is what actually gates it), so it will get
# arbitrary/abusive traffic. Reject an implausibly large body outright,
# before spending any CPU parsing it as JSON. Default shown.
# MAX_REQUEST_BODY_BYTES=1048576

# Logging is hardcoded in app/logging_config.py — not configurable via
# environment. It auto-detects JSON (Cloud Logging) vs plain text based on
# whether K_SERVICE/FUNCTION_TARGET are set (i.e. running on GCP vs local).

# Functions Framework itself reads PORT for local `functions-framework
# --port=...` runs; it isn't read by any code in this app.
